[Unit]
Description=ShockCraft electrical planner
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=shockcraft
Group=shockcraft
WorkingDirectory=/srv/shockcraft/current
ExecStart=/usr/bin/node --env-file=/srv/shockcraft/.env.production /srv/shockcraft/current/scripts/start-node.mjs
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
UMask=0077

[Install]
WantedBy=multi-user.target
